# Local justfile settings. Copy to .env and configure the repository owners.
# Keep the PAT in the separate PROXY_PRIVATE/token file, not in this file.
ALLOWED_ORGS=
ALLOWED_USERS=
BRANCH_PREFIX=agent/

# Defaults below can be overridden here or in your shell.
# PROXY_PRIVATE=/absolute/path/to/github-agent-proxy-private
# PROXY_IMAGE=github-agent-proxy:local
# TEST_IMAGE=github-agent-proxy:test
# PROXY_NAME=github-agent-proxy
# PROXY_PORT=8443

# JSON policy: remove ALLOWED_ORGS, ALLOWED_USERS and BRANCH_PREFIX above.
# For Apple Container these files must be under PROXY_PRIVATE.
# POLICY_FILE=/absolute/path/to/github-agent-proxy-private/policy.json
# INTERCEPT_CA_CERT_FILE=/absolute/path/to/github-agent-proxy-private/intercept-ca.pem
# INTERCEPT_CA_KEY_FILE=/absolute/path/to/github-agent-proxy-private/intercept-ca-key.pem
