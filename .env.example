# Local justfile settings. Copy to .env and configure the repository owners.
# Keep the PAT in the separate PROXY_PRIVATE/token file, not in this file.
ALLOWED_ORGS=
ALLOWED_USERS=
BRANCH_PREFIX=agent/

# Defaults below can be overridden here or in your shell.
# PROXY_PRIVATE=/absolute/path/to/github-agent-proxy-private
# PROXY_IMAGE=github-agent-proxy:local
# TEST_IMAGE=github-agent-proxy:test
# PROXY_NAME=github-agent-proxy
# PROXY_PORT=8443
