# syntax=docker/dockerfile:1
# Self-contained test workspace; no host credentials or source mounts required.
FROM golang:1.27.3-alpine

# git-daemon supplies git http-backend for the real Git integration tests.
# build-base supplies the C toolchain required by Go's race detector.
RUN apk add --no-cache \
    bash build-base ca-certificates curl git git-daemon github-cli openssl

WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY examples ./examples
COPY notices.go THIRD_PARTY_NOTICES.md ./
RUN go build -trimpath -o /usr/local/bin/github-agent-proxy ./cmd/github-agent-proxy \
    && go test -race -run '^$' ./...

# All dependencies are cached; tests can run with external networking disabled.
ENV GOTOOLCHAIN=local GOPROXY=off
CMD ["go", "test", "-race", "-count=1", "-timeout=3m", "./..."]
